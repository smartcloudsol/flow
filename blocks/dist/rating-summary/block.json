{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "smartcloud-flow/rating-summary",
  "version": "1.0.0",
  "title": "Flow Rating Summary",
  "category": "smartcloud-flow",
  "icon": "star-filled",
  "description": "Content-bound rating totals and distribution rendered from the Flow backend.",
  "supports": {
    "html": false
  },
  "usesContext": [
    "postId",
    "postType"
  ],
  "attributes": {
    "formId": {
      "type": "string",
      "role": "content"
    },
    "contentTargetSource": {
      "type": "string",
      "role": "content",
      "default": "wordpress-context"
    },
    "targetNamespace": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "targetType": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "targetId": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "discussionChannel": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "title": {
      "type": "string",
      "role": "content"
    },
    "showDistribution": {
      "type": "boolean",
      "role": "content",
      "default": true
    },
    "averageRatingLabel": {
      "type": "string",
      "role": "content"
    },
    "ratingCountLabel": {
      "type": "string",
      "role": "content"
    },
    "ratingCountPluralLabel": {
      "type": "string",
      "role": "content"
    },
    "ratingDistributionLabel": {
      "type": "string",
      "role": "content"
    },
    "ratingValueTemplate": {
      "type": "string",
      "role": "content"
    },
    "loadingMessage": {
      "type": "string",
      "role": "content"
    },
    "errorMessage": {
      "type": "string",
      "role": "content"
    },
    "retryLabel": {
      "type": "string",
      "role": "content"
    },
    "emptyMessage": {
      "type": "string",
      "role": "content"
    },
    "ratingUnavailableMessage": {
      "type": "string",
      "role": "content"
    },
    "language": {
      "type": "string",
      "role": "content"
    },
    "direction": {
      "type": "string",
      "role": "content"
    },
    "colorMode": {
      "type": "string",
      "role": "content",
      "default": "light"
    },
    "primaryColor": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "themeOverrides": {
      "type": "string",
      "role": "content",
      "default": ""
    }
  },
  "editorScript": "smartcloud-flow-blocks-editor-script",
  "viewScript": "smartcloud-flow-view-script",
  "style": "file:./styles.css",
  "render": "file:./render.php"
}