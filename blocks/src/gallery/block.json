{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "smartcloud-flow/gallery",
  "version": "1.0.0",
  "title": "Gallery",
  "category": "smartcloud-flow",
  "icon": "format-gallery",
  "description": "Display a navigable image gallery, including modal-driven start positions.",
  "supports": {
    "html": false,
    "reusable": false,
    "anchor": true,
    "className": true,
    "customClassName": true
  },
  "attributes": {
    "galleryId": {
      "type": "string",
      "default": ""
    },
    "startIndex": {
      "type": "number",
      "default": 1
    },
    "loop": {
      "type": "boolean",
      "default": true
    },
    "showCounter": {
      "type": "boolean",
      "default": true
    },
    "showThumbnails": {
      "type": "boolean",
      "default": true
    },
    "showCaptions": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "smartcloud-flow-blocks-editor-script",
  "style": "smartcloud-flow-modal-view-style",
  "viewScript": "smartcloud-flow-modal-view-script"
}
