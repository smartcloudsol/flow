{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "smartcloud-flow/discussion",
  "version": "1.0.0",
  "title": "Flow Discussion",
  "category": "smartcloud-flow",
  "icon": "admin-comments",
  "description": "Content-bound public discussion rendered from the Flow backend.",
  "supports": { "html": false },
  "usesContext": ["postId", "postType"],
  "attributes": {
    "formId": { "type": "string", "role": "content" },
    "contentTargetSource": { "type": "string", "role": "content", "default": "wordpress-context" },
    "targetNamespace": { "type": "string", "role": "content", "default": "" },
    "targetType": { "type": "string", "role": "content", "default": "" },
    "targetId": { "type": "string", "role": "content", "default": "" },
    "discussionChannel": { "type": "string", "role": "content", "default": "" },
    "pageSize": { "type": "number", "role": "content", "default": 20 },
    "replyPageSize": { "type": "number", "role": "content", "default": 10 },
    "replyPreviewLimit": { "type": "number", "role": "content", "default": 2 },
    "initialReplyDepth": { "type": "number", "role": "content", "default": 1 },
    "rootSortDirection": { "type": "string", "role": "content", "default": "desc" },
    "replySortDirection": { "type": "string", "role": "content", "default": "desc" },
    "showRatingSummary": { "type": "boolean", "role": "content", "default": true },
    "showRatingFilter": { "type": "boolean", "role": "content", "default": true },
    "ratingFilterOperator": { "type": "string", "role": "content", "default": "all" },
    "ratingFilterValue": { "type": "number", "role": "content", "default": 5 },
    "allRatingsLabel": { "type": "string", "role": "content" },
    "atLeastLabel": { "type": "string", "role": "content" },
    "atMostLabel": { "type": "string", "role": "content" },
    "averageRatingLabel": { "type": "string", "role": "content" },
    "exactlyLabel": { "type": "string", "role": "content" },
    "filterRatingsLabel": { "type": "string", "role": "content" },
    "ratingCountLabel": { "type": "string", "role": "content" },
    "ratingCountPluralLabel": { "type": "string", "role": "content" },
    "ratingDistributionLabel": { "type": "string", "role": "content" },
    "ratingValueLabel": { "type": "string", "role": "content" },
    "ratingValueTemplate": { "type": "string", "role": "content" },
    "title": { "type": "string", "role": "content" },
    "emptyMessage": { "type": "string", "role": "content" },
    "loadingMessage": { "type": "string", "role": "content" },
    "errorMessage": { "type": "string", "role": "content" },
    "retryLabel": { "type": "string", "role": "content" },
    "anonymousAuthorLabel": { "type": "string", "role": "content" },
    "tombstoneLabel": { "type": "string", "role": "content" },
    "replyLabel": { "type": "string", "role": "content" },
    "cancelReplyLabel": { "type": "string", "role": "content" },
    "loadMoreLabel": { "type": "string", "role": "content" },
    "loadReplyLabel": { "type": "string", "role": "content" },
    "loadRepliesLabel": { "type": "string", "role": "content" },
    "replyCountLabel": { "type": "string", "role": "content" },
    "replyCountPluralLabel": { "type": "string", "role": "content" },
    "showCommentCount": { "type": "boolean", "role": "content", "default": true },
    "commentCountLabel": { "type": "string", "role": "content" },
    "commentCountPluralLabel": { "type": "string", "role": "content" },
    "depthLimitLabel": { "type": "string", "role": "content" },
    "editLabel": { "type": "string", "role": "content" },
    "deleteLabel": { "type": "string", "role": "content" },
    "saveEditLabel": { "type": "string", "role": "content" },
    "cancelEditLabel": { "type": "string", "role": "content" },
    "editedLabel": { "type": "string", "role": "content" },
    "deleteConfirmTitle": { "type": "string", "role": "content" },
    "deleteConfirmMessage": { "type": "string", "role": "content" },
    "deleteConfirmLabel": { "type": "string", "role": "content" },
    "cancelDeleteLabel": { "type": "string", "role": "content" },
    "actionErrorMessage": { "type": "string", "role": "content" },
    "discussionAuthMode": { "type": "string", "role": "content", "default": "anonymous" },
    "discussionAllowedGroups": { "type": "array", "role": "content", "default": [] },
    "showDate": { "type": "boolean", "role": "content", "default": true },
    "dateStyle": { "type": "string", "role": "content", "default": "medium" },
    "timeStyle": { "type": "string", "role": "content", "default": "short" },
    "language": { "type": "string", "role": "content" },
    "direction": { "type": "string", "role": "content" },
    "colorMode": { "type": "string", "role": "content", "default": "light" },
    "primaryColor": { "type": "string", "role": "content", "default": "" },
    "themeOverrides": { "type": "string", "role": "content", "default": "" }
  },
  "editorScript": "smartcloud-flow-blocks-editor-script",
  "viewScript": "smartcloud-flow-view-script",
  "style": "file:./styles.css",
  "render": "file:./render.php"
}
