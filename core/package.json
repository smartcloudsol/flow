{
  "name": "@smart-cloud/flow-core",
  "version": "1.1.10",
  "description": "Flow Core Package",
  "author": "Smart Cloud Solutions Inc.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn build:js && yarn build:types",
    "build:js": "tsup --minify",
    "build:types": "tsc -p tsconfig.types.json",
    "lint": "eslint 'src/**/*.ts' --report-unused-disable-directives --max-warnings 0",
    "test": "esbuild tests/backend.test.ts --bundle --platform=node --format=cjs --packages=external --outfile=.test-dist/backend.test.cjs && node --test .test-dist/backend.test.cjs",
    "release:npm": "WPSUITE_PREMIUM=true yarn build && npm publish --access=public --registry=https://registry.npmjs.org/"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "resolutions": {
    "brace-expansion": "^5.0.9",
    "esbuild": "^0.28.1",
    "fast-xml-builder": "^1.3.0",
    "fast-xml-parser": "^5.10.1",
    "flatted": "^3.4.4",
    "picomatch": "^4.0.5",
    "rollup": "^4.62.3"
  },
  "dependencies": {
    "@smart-cloud/gatey-core": "^2.3.4",
    "@smart-cloud/wpsuite-core": "^2.3.2",
    "aws-amplify": "^6.20.0"
  },
  "peerDependencies": {
    "@wordpress/data": "^10.52.0",
    "@wordpress/i18n": "^6.25.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@aws-amplify/core": "^6.18.0",
    "@smart-cloud/aws-amplify-ui": "6.15.5",
    "@smart-cloud/aws-amplify-ui-react": "6.15.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@wordpress/data": "^10.52.0",
    "@wordpress/i18n": "^6.25.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jose": "^6.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
